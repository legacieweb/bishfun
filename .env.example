# Bishfun — Environment Variables
# Copy this file to .env.local and fill in your values.

# === Travelpayouts Integration ===
# Partner ID from Travelpayouts Partner Center (public, safe for browser)
VITE_TRAVELPAYOUTS_PARTNER_ID=

# Project ID from Travelpayouts Partner Center (public, safe for browser)
VITE_TRAVELPAYOUTS_PROJECT_ID=

# Travelpayouts API token (keep server-side; do NOT expose to browser in production)
VITE_TRAVELPAYOUTS_TOKEN=

# Default currency for affiliate links
VITE_TRAVELPAYOUTS_CURRENCY=USD

# Default locale for affiliate links
VITE_TRAVELPAYOUTS_LOCALE=en

# Travelpayouts Drive script URL
# DO NOT hardcode this. Obtain from Travelpayouts Partner Center.
# In production, serve this via your own backend endpoint to avoid
# exposing partner IDs in client-side code.
VITE_TRAVELPAYOUTS_DRIVE_SCRIPT_URL=

# === Analytics ===
# Google Analytics or similar measurement ID
VITE_ANALYTICS_ID=

# === Site ===
# Site URL used for SEO metadata and sitemap
VITE_SITE_URL=https://bishfun.com

# === IMPORTANT SECURITY NOTE ===
# Any variable prefixed with VITE_ is inlined into your client-side bundle
# and IS PUBLIC. Never put secret keys here.
# If you need to keep a credential secret (e.g., Travelpayouts API token),
# implement a server-side proxy or API route that injects the secret.
